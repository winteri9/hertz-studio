---
/**
 * Верхняя навигация. Абсолютная: живёт только над первым экраном.
 * На мобильном остаются логотип и короткий контактный CTA.
 */
import { NAV, SITE } from '../data/site';
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="brand" href="#hero" aria-label={`${SITE.name} — в начало`}>
      <span class="brand__mark" aria-hidden="true">
        <i></i><i></i><i></i><i></i>
      </span>
      <span class="brand__name">{SITE.name}</span>
      <span class="brand__sub">Studio</span>
    </a>

    <nav class="site-nav" aria-label="Основная навигация">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="header-cta" href="#contact">
      <span>Забронировать</span>
      <span class="header-cta__arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 40;
    padding-top: 22px;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    min-height: 32px;
  }

  .brand__mark {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
  }

  .brand__mark i {
    display: block;
    width: 3px;
    background: var(--accent);
  }

  .brand__mark i:nth-child(1) {
    height: 8px;
  }
  .brand__mark i:nth-child(2) {
    height: 16px;
  }
  .brand__mark i:nth-child(3) {
    height: 22px;
  }
  .brand__mark i:nth-child(4) {
    height: 12px;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--paper);
  }

  .brand__sub {
    margin-left: 2px;
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .site-nav {
    justify-self: center;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.6vw, 36px);
  }

  .site-nav a {
    position: relative;
    display: inline-block;
    padding: 6px 0;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper);
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s var(--ease);
  }

  .site-nav a:hover::after,
  .site-nav a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper);
  }

  .header-cta::before {
    content: '';
    width: 16px;
    height: 1px;
    background: var(--accent);
  }

  .header-cta__arrow {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--line-dark);
    color: var(--accent);
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .header-cta:hover .header-cta__arrow {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }

    .site-nav {
      display: none;
    }

    .site-header {
      padding-top: 18px;
    }
  }

  @media (max-width: 480px) {
    .header-cta span:first-child {
      display: none;
    }

    .header-cta::before {
      display: none;
    }

    .brand__sub {
      display: none;
    }
  }
</style>
