---
/**
 * Services — четыре этапа работы.
 * Читает SERVICES, ничего не дублирует текстом в разметке.
 */
import { SERVICES } from '../../data/services';
---

<section class="services surface-paper" id="services" aria-labelledby="services-title">
  <div class="container">
    <header class="services__head">
      <p class="section-label" data-reveal><span>01</span> Услуги</p>
      <h2 class="services__title" id="services-title" data-reveal>
        Один сигнал.<br />Четыре этапа.
      </h2>
      <p class="services__intro" data-reveal>
        Не передаём проект по цепочке. Запись, сведение, мастеринг и продакшн остаются в одной
        комнате — и в одних руках.
      </p>
    </header>

    <ol class="services__grid" role="list">
      {
        SERVICES.map((service, index) => (
          <li class="service" data-reveal>
            <div class="service__top">
              <span class="service__number mono">{String(index + 1).padStart(2, '0')}</span>
              <span class="service__code mono">{service.code}</span>
              <span class="service__arrow" aria-hidden="true">↗</span>
            </div>
            <div class="service__body">
              <h3 class="service__name">{service.name}</h3>
              <p class="service__summary">{service.summary}</p>
              <ul class="service__includes" role="list">
                {service.includes.map((item) => (
                  <li>
                    <span class="service__plus" aria-hidden="true">+</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="services__foot" data-reveal>
      <p class="mono">HZ / 01—04</p>
      <p>Начнём с разговора о треке, а не с прайса.</p>
      <a class="services__link" href="#contact">
        Обсудить проект
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    padding-block: var(--sec-pad);
  }

  .services__head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
    align-items: end;
    margin-bottom: clamp(48px, 6vw, 84px);
  }

  .services__head .section-label {
    grid-column: 1 / span 3;
    align-self: start;
    padding-top: 6px;
  }

  .services__title {
    grid-column: 1 / span 7;
    grid-row: 2;
    font-size: clamp(48px, 6.8vw, 96px);
    line-height: 0.94;
  }

  .services__intro {
    grid-column: 9 / span 4;
    max-width: 330px;
    padding-bottom: 8px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-muted);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }

  .service {
    display: flex;
    flex-direction: column;
    min-height: clamp(300px, 31vw, 420px);
    padding: clamp(22px, 2.6vw, 36px);
    background: var(--paper);
    color: var(--ink);
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }

  .service:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .service__top {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding-bottom: clamp(28px, 4vw, 54px);
  }

  .service__number {
    font-size: clamp(40px, 4.4vw, 64px);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--muted-ink);
    transition: color 0.35s var(--ease);
  }

  .service:hover .service__number {
    color: var(--accent);
  }

  .service__code {
    margin-top: 7px;
    font-size: 8px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .service__arrow {
    margin-left: auto;
    font-size: 20px;
    line-height: 1;
    color: var(--fg-muted);
    transform: translate(0, 0);
    transition:
      color 0.35s var(--ease),
      transform 0.35s var(--ease);
  }

  .service:hover .service__arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  .service__body {
    margin-top: auto;
  }

  .service__name {
    font-size: clamp(40px, 4.5vw, 64px);
    line-height: 0.9;
  }

  .service__summary {
    max-width: 460px;
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-muted);
    transition: color 0.35s var(--ease);
  }

  .service:hover .service__summary,
  .service:hover .service__code,
  .service:hover .service__arrow {
    color: var(--muted);
  }

  .service:hover .service__summary {
    color: color-mix(in srgb, var(--paper) 72%, transparent);
  }

  .service__includes {
    display: grid;
    gap: 6px;
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--hairline-light);
    font-size: 12px;
    line-height: 1.4;
    color: var(--fg-muted);
    transition:
      border-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }

  .service:hover .service__includes {
    border-color: var(--hairline-dark);
    color: var(--muted);
  }

  .service__includes li {
    display: flex;
    gap: 8px;
  }

  .service__plus {
    color: var(--accent-ink);
  }

  .service:hover .service__plus {
    color: var(--accent);
  }

  .services__foot {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .services__foot p:nth-child(2) {
    justify-self: center;
    text-align: center;
  }

  .services__link {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    border-bottom: 1px solid var(--accent-ink);
    padding-bottom: 3px;
  }

  .services__link span {
    color: var(--accent-ink);
  }

  .services__link:hover {
    color: var(--accent-ink);
  }

  @media (max-width: 980px) {
    .services__head {
      grid-template-columns: repeat(6, 1fr);
    }

    .services__title {
      grid-column: 1 / span 6;
      grid-row: 2;
    }

    .services__intro {
      grid-column: 1 / span 4;
      grid-row: 3;
      margin-top: 4px;
    }
  }

  @media (max-width: 720px) {
    .services__head {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
    }

    .services__title {
      font-size: clamp(42px, 12vw, 64px);
    }

    .services__intro {
      max-width: 100%;
      font-size: 13px;
    }

    .services__grid {
      grid-template-columns: 1fr;
    }

    .service {
      min-height: 0;
      padding: 22px 20px 24px;
    }

    .service__top {
      padding-bottom: 34px;
    }

    .service__name {
      font-size: clamp(42px, 12vw, 56px);
    }

    .services__foot {
      grid-template-columns: 1fr auto;
      margin-top: 22px;
    }

    .services__foot p:nth-child(2) {
      display: none;
    }
  }
</style>
