---
/**
 * PricingQuiz — интерактивный демо-расчёт.
 * Данные и ставки — в src/data/pricing.ts; расчёт — в src/scripts/pricing.ts.
 * Без JS остаётся статичная смета в <noscript>.
 */
import { PRICING_DURATIONS, PRICING_SERVICES } from '../../data/pricing';

const rub = (value: number) => value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '\u00A0');
---

<section class="pricing surface-ink" id="pricing" aria-labelledby="pricing-title">
  <div class="container">
    <header class="pricing__head">
      <p class="section-label" data-reveal><span>04</span> Калькулятор</p>
      <h2 class="pricing__title" id="pricing-title" data-reveal>
        Рассчитать<br />стоимость записи
      </h2>
      <p class="pricing__intro" data-reveal>
        Три шага, чтобы понять порядок бюджета. Это демо-расчёт: финальная смета — после брифа.
      </p>
    </header>

    <form class="pricing__form" data-pricing-form data-reveal>
      <fieldset class="pricing__step">
        <legend class="pricing__legend">
          <span class="pricing__step-number mono">01</span>
          <span>Выбери услугу</span>
        </legend>
        <div class="pricing__services">
          {
            PRICING_SERVICES.map((service, index) => (
              <label class="pricing__option">
                <input
                  class="pricing__input"
                  type="radio"
                  name="service"
                  value={service.id}
                  data-rate={service.rate}
                  data-label={service.name}
                  checked={index === 0}
                />
                <span class="pricing__option-body">
                  <span class="pricing__option-top mono">0{index + 1}</span>
                  <span class="pricing__option-name">{service.name}</span>
                  <span class="pricing__option-note">{service.note}</span>
                  <span class="pricing__option-rate mono">{rub(service.rate)} ₽ / час</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="pricing__step">
        <legend class="pricing__legend">
          <span class="pricing__step-number mono">02</span>
          <span>Выбери длительность</span>
        </legend>
        <div class="pricing__durations">
          {
            PRICING_DURATIONS.map((duration) => (
              <label class="pricing__option pricing__option--duration">
                <input
                  class="pricing__input"
                  type="radio"
                  name="duration"
                  value={String(duration.hours)}
                  data-hours={duration.hours}
                  checked={duration.hours === 4}
                />
                <span class="pricing__option-body">
                  <span class="pricing__option-name">{duration.label}</span>
                  <span class="pricing__option-note">Смена</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="pricing__action">
        <p class="pricing__hint mono">03 / Цена</p>
        <button class="button button--solid pricing__button" type="button" data-price-submit>
          <span>Узнать цену</span>
          <span aria-hidden="true">↗</span>
        </button>
      </div>
    </form>

    <div class="pricing__result" data-price-result hidden aria-live="polite">
      <div>
        <p class="pricing__result-label mono">Предварительная стоимость</p>
        <p class="pricing__result-price mono" data-price-value>—</p>
        <p class="pricing__result-detail" data-price-detail></p>
      </div>
      <div class="pricing__result-side">
        <a
          class="button button--solid"
          href="https://t.me/winteri9"
          target="_blank"
          rel="noopener"
        >
          <span>Обсудить в Telegram</span>
          <span aria-hidden="true">↗</span>
        </a>
        <p class="pricing__result-note mono">Демо-расчёт · точная смета после брифа</p>
      </div>
    </div>

    <noscript>
      <div class="pricing__noscript">
        <p class="mono">Демо-ставки</p>
        <p>Запись — 4 500 ₽/час. Сведение — 3 500 ₽/час. Мастеринг — 2 500 ₽/час.</p>
        <p>Для точного расчёта напиши в Telegram: <a href="https://t.me/winteri9">@winteri9</a>.</p>
      </div>
    </noscript>
  </div>
</section>

<style>
  .pricing {
    padding-block: var(--sec-pad);
  }

  .pricing__head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
    align-items: start;
    margin-bottom: clamp(42px, 5vw, 72px);
  }

  .pricing__head .section-label {
    grid-column: 1 / span 3;
    padding-top: 7px;
  }

  .pricing__title {
    grid-column: 1 / span 7;
    grid-row: 2;
    font-size: clamp(46px, 7vw, 100px);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .pricing__intro {
    grid-column: 9 / span 4;
    grid-row: 2;
    max-width: 330px;
    padding-top: 6px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
  }

  .pricing__form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 40px;
    padding-top: 28px;
    border-top: 1px solid var(--hairline-dark);
  }

  .pricing__step {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .pricing__legend {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pricing__step-number {
    color: var(--accent);
  }

  .pricing__services {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .pricing__durations {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .pricing__option {
    position: relative;
    display: block;
    min-width: 0;
    cursor: pointer;
  }

  .pricing__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .pricing__option-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 144px;
    padding: 16px 14px;
    border: 1px solid var(--hairline-dark);
    background: var(--ink-2);
    transition:
      border-color 0.25s var(--ease),
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .pricing__option:hover .pricing__option-body {
    border-color: var(--muted);
  }

  .pricing__option:has(.pricing__input:checked) .pricing__option-body {
    border-color: var(--accent);
    background: var(--ink);
  }

  .pricing__input:focus-visible + .pricing__option-body {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .pricing__option--duration .pricing__option-body {
    min-height: 94px;
    justify-content: space-between;
  }

  .pricing__option-top {
    font-size: 8px;
    line-height: 1;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .pricing__option-name {
    font-family: var(--font-display);
    font-size: clamp(22px, 2vw, 30px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--paper);
  }

  .pricing__option-note {
    margin-top: auto;
    font-size: 11px;
    line-height: 1.3;
    color: var(--muted);
  }

  .pricing__option-rate {
    font-size: 8px;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .pricing__option:has(.pricing__input:checked) .pricing__option-rate {
    color: var(--accent);
  }

  .pricing__action {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 8px;
  }

  .pricing__hint {
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pricing__button {
    min-width: 220px;
  }

  .pricing__result {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px 48px;
    align-items: end;
    margin-top: 28px;
    padding: 24px 28px;
    border: 1px solid var(--accent);
    background: var(--ink-2);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
  }

  .pricing__result[hidden] {
    display: none;
  }

  .pricing__result.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .pricing__result-label,
  .pricing__result-note {
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pricing__result-price {
    margin-top: 4px;
    font-size: clamp(42px, 5.2vw, 76px);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--accent);
  }

  .pricing__result-detail {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--paper);
  }

  .pricing__result-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .pricing__noscript {
    display: grid;
    gap: 8px;
    margin-top: 24px;
    padding: 20px;
    border: 1px solid var(--hairline-dark);
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  .pricing__noscript p:first-child {
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .pricing__noscript a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1000px) {
    .pricing__head {
      grid-template-columns: repeat(6, 1fr);
    }

    .pricing__title {
      grid-column: 1 / span 6;
    }

    .pricing__intro {
      grid-column: 1 / span 4;
      padding-top: 0;
    }

    .pricing__form {
      grid-template-columns: 1fr;
    }

    .pricing__action {
      grid-column: 1;
    }
  }

  @media (max-width: 720px) {
    .pricing__head {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .pricing__title {
      font-size: clamp(42px, 13vw, 64px);
    }

    .pricing__intro {
      max-width: 100%;
      font-size: 13px;
    }

    .pricing__form {
      gap: 26px;
    }

    .pricing__services {
      grid-template-columns: 1fr;
    }

    .pricing__durations {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pricing__option-body {
      min-height: 108px;
    }

    .pricing__option--duration .pricing__option-body {
      min-height: 82px;
    }

    .pricing__action {
      flex-direction: column;
      align-items: stretch;
    }

    .pricing__button {
      width: 100%;
    }

    .pricing__result {
      grid-template-columns: 1fr;
      padding: 20px;
    }

    .pricing__result-side {
      align-items: stretch;
    }

    .pricing__result-side .button {
      width: 100%;
    }
  }
</style>
