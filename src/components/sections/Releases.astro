---
/**
 * Releases — каталог студии.
 * Четыре карточки, обложки — локальные фото из PHOTO_FILES.
 * VHS-эффект на наведении: два цветовых слоя и масштаб внутри кадра.
 */
import { Image } from 'astro:assets';
import { localPhoto } from '../../lib/images';
import { PHOTO_FILES, PHOTO_ALTS } from '../../data/photos';
import { RELEASES } from '../../data/releases';
---

<section class="releases surface-ink" id="releases" aria-labelledby="releases-title">
  <div class="container">
    <header class="releases__head">
      <p class="section-label" data-reveal><span>02</span> Релизы</p>
      <div class="releases__heading" data-reveal>
        <h2 class="releases__title" id="releases-title">Наши релизы</h2>
        <p class="releases__intro">
          Четыре записи, в которых слышно, как мы работаем: от первого дубля до финальной
          мастер-ленты.
        </p>
      </div>
      <div class="releases__count" data-reveal>
        <span class="mono">04 / 2024—2026</span>
        <span class="mono">Selected work</span>
      </div>
    </header>

    <div class="releases__grid">
      {
        RELEASES.map((release, index) => {
          const cover = localPhoto(PHOTO_FILES[release.cover]);
          return (
            <article class="release" data-reveal>
              <div
                class="release__art"
                style={`--cover: url(${cover.src}); --cover-position: ${release.coverPosition};`}
              >
                <Image
                  class="release__image"
                  src={cover}
                  alt={PHOTO_ALTS[release.cover]}
                  widths={[480, 720, 960]}
                  sizes="(max-width: 720px) 45vw, (max-width: 1100px) 45vw, 25vw"
                  format="webp"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                />
                <span class="release__wash release__wash--red" aria-hidden="true"></span>
                <span class="release__wash release__wash--cyan" aria-hidden="true"></span>
                <span class="release__scanlines" aria-hidden="true"></span>

                <span class="release__catalog mono">{release.catalog}</span>
                <span class="release__format mono">{release.format}</span>
                <span class="release__play mono" aria-hidden="true">
                  <span class="release__play-icon">▶</span> PLAY
                </span>
                <span class="release__index mono" aria-hidden="true">
                  0{index + 1}
                </span>
              </div>

              <div class="release__meta">
                <h3 class="release__name">{release.title}</h3>
                <p class="release__artist mono">{release.artist}</p>
                <p class="release__details mono">
                  <span>{release.genre}</span>
                  <span>{release.year}</span>
                </p>
              </div>
            </article>
          );
        })
      }
    </div>

    <p class="releases__foot mono" data-reveal>
      <span aria-hidden="true">[</span> HZ / CATALOGUE <span aria-hidden="true">]</span>
      <span>Обложки — кадры из архива студии</span>
    </p>
  </div>
</section>

<style>
  .releases {
    padding-block: var(--sec-pad);
    overflow: hidden;
  }

  .releases__head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
    align-items: start;
    margin-bottom: clamp(44px, 5vw, 72px);
  }

  .releases__head .section-label {
    grid-column: 1 / span 3;
    padding-top: 7px;
  }

  .releases__heading {
    grid-column: 1 / span 7;
    grid-row: 2;
  }

  .releases__title {
    font-size: clamp(54px, 8.6vw, 124px);
    line-height: 0.88;
    letter-spacing: -0.06em;
  }

  .releases__intro {
    max-width: 440px;
    margin-top: 20px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
  }

  .releases__count {
    grid-column: 10 / span 3;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    padding-top: 8px;
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .releases__count span:last-child {
    color: var(--accent);
  }

  .releases__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 1.7vw, 24px);
  }

  .release {
    min-width: 0;
  }

  .release__art {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--ink-2);
    isolation: isolate;
  }

  .release__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--cover-position, 50% 50%);
    filter: grayscale(1) contrast(1.12) brightness(0.82);
    transform: scale(1.01);
    transition:
      transform 1.1s var(--ease),
      filter 0.5s var(--ease);
  }

  .release:hover .release__image {
    transform: scale(1.055);
    filter: grayscale(0.65) contrast(1.1) brightness(0.9);
  }

  .release__wash {
    position: absolute;
    inset: 0;
    z-index: 2;
    background-image: var(--cover);
    background-size: cover;
    background-position: var(--cover-position, 50% 50%);
    filter: grayscale(1) contrast(1.4) sepia(1) saturate(5);
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }

  .release__wash--red {
    filter: grayscale(1) contrast(1.45) sepia(1) saturate(6) hue-rotate(310deg);
    transform: translate3d(-5px, 0, 0);
  }

  .release__wash--cyan {
    filter: grayscale(1) contrast(1.45) sepia(1) saturate(6) hue-rotate(145deg);
    transform: translate3d(5px, 0, 0);
  }

  .release:hover .release__wash {
    opacity: 0.5;
  }

  .release__scanlines {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 2px,
      color-mix(in srgb, var(--ink) 45%, transparent) 2px 4px
    );
    opacity: 0.28;
    mix-blend-mode: multiply;
    pointer-events: none;
    transition: opacity 0.4s var(--ease);
  }

  .release:hover .release__scanlines {
    opacity: 0.55;
  }

  .release__catalog,
  .release__format,
  .release__play,
  .release__index {
    position: absolute;
    z-index: 4;
    font-size: 8px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .release__catalog {
    top: 12px;
    left: 12px;
    padding: 5px 6px;
    background: color-mix(in srgb, var(--ink) 72%, transparent);
    color: var(--paper);
  }

  .release__format {
    top: 12px;
    right: 12px;
    padding: 5px 6px;
    background: var(--accent);
    color: var(--ink);
  }

  .release__play {
    left: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 6px;
    background: var(--ink);
    color: var(--accent);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .release:hover .release__play {
    opacity: 1;
    transform: translateY(0);
  }

  .release__play-icon {
    font-size: 6px;
  }

  .release__index {
    right: 12px;
    bottom: 12px;
    color: var(--paper);
    mix-blend-mode: difference;
  }

  .release__meta {
    padding-top: 14px;
    border-top: 1px solid var(--hairline-dark);
    margin-top: 12px;
  }

  .release__name {
    font-size: clamp(22px, 2.1vw, 32px);
    line-height: 1;
    letter-spacing: -0.04em;
    transition: color 0.25s var(--ease);
  }

  .release:hover .release__name {
    color: var(--accent);
  }

  .release__artist {
    margin-top: 8px;
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper);
  }

  .release__details {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
    font-size: 8px;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .releases__foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 34px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline-dark);
    font-size: 8px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .releases__foot span:first-child {
    color: var(--accent);
  }

  @media (max-width: 1000px) {
    .releases__head {
      grid-template-columns: repeat(6, 1fr);
    }

    .releases__heading {
      grid-column: 1 / span 5;
    }

    .releases__count {
      grid-column: 6 / span 1;
    }

    .releases__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 14px;
    }
  }

  @media (max-width: 720px) {
    .releases__head {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .releases__title {
      font-size: clamp(48px, 15vw, 72px);
    }

    .releases__intro {
      margin-top: 14px;
      font-size: 13px;
    }

    .releases__count {
      flex-direction: row;
      gap: 16px;
      padding-top: 0;
    }

    .releases__grid {
      gap: 24px 12px;
    }

    .release__meta {
      padding-top: 10px;
      margin-top: 10px;
    }

    .release__name {
      font-size: 22px;
    }

    .release__artist {
      margin-top: 6px;
      font-size: 9px;
    }

    .release__details {
      margin-top: 8px;
      font-size: 8px;
    }

    .release__play {
      display: none;
    }

    .releases__foot span:last-child {
      display: none;
    }
  }
</style>
