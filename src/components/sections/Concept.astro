---
/**
 * Concept — честная плашка о том, что HERTZ является концептом VOIDCODE.
 * Светлая поверхность, один акцент, реальный Telegram-контакт.
 */
import { CONTACTS } from '../../data/site';
---

<section class="concept surface-paper" id="concept" aria-labelledby="concept-title">
  <div class="container">
    <div class="concept__panel" data-reveal>
      <div class="concept__meta">
        <p class="section-label"><span>05</span> Концепт</p>
        <p class="concept__code mono">VOIDCODE / HERTZ</p>
      </div>

      <div class="concept__body">
        <h2 class="concept__title" id="concept-title">
          Этот сайт —<br />концепт VOIDCODE.
        </h2>
        <p class="concept__text">
          Соберём такой же для вашей студии звукозаписи: ваш бренд, ваши услуги, интеграция с CRM.
        </p>
        <a
          class="button button--solid concept__button"
          href={CONTACTS.telegramHref}
          target="_blank"
          rel="noopener"
        >
          <span>Обсудить проект в Telegram</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <aside class="concept__aside" aria-label="Что входит в концепт">
        <span class="concept__mark" aria-hidden="true">HZ</span>
        <p>Дизайн, вёрстка, GSAP, аудиовизуализация и машинные проверки.</p>
        <p class="concept__contact mono">{CONTACTS.telegram}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .concept {
    padding-block: clamp(56px, 7vw, 96px);
    border-top: 1px solid var(--hairline-light);
  }

  .concept__panel {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr) 220px;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
    padding: clamp(24px, 4vw, 56px);
    background: color-mix(in srgb, var(--paper) 72%, var(--white));
    border: 1px solid var(--hairline-light);
    border-top: 4px solid var(--accent);
  }

  .concept__meta {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .concept__code {
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .concept__title {
    max-width: 780px;
    font-size: clamp(48px, 6.8vw, 104px);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .concept__text {
    max-width: 560px;
    margin-top: 24px;
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .concept__button {
    margin-top: 28px;
  }

  .concept__aside {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .concept__mark {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(64px, 6.4vw, 96px);
    font-weight: 900;
    line-height: 0.75;
    letter-spacing: -0.08em;
    color: color-mix(in srgb, var(--ink) 14%, transparent);
  }

  .concept__contact {
    padding-top: 16px;
    border-top: 1px solid var(--hairline-light);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  @media (max-width: 1000px) {
    .concept__panel {
      grid-template-columns: 150px minmax(0, 1fr);
    }

    .concept__aside {
      grid-column: 2;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 16px;
      align-items: end;
    }

    .concept__mark {
      display: none;
    }

    .concept__contact {
      border-top: 0;
      padding-top: 0;
      text-align: right;
    }
  }

  @media (max-width: 720px) {
    .concept {
      padding-block: 40px;
    }

    .concept__panel {
      display: flex;
      flex-direction: column;
      gap: 24px;
      padding: 22px 20px 26px;
      border-top-width: 3px;
    }

    .concept__meta {
      gap: 10px;
    }

    .concept__title {
      font-size: clamp(40px, 12vw, 58px);
    }

    .concept__text {
      margin-top: 18px;
      font-size: 14px;
    }

    .concept__button {
      width: 100%;
      margin-top: 22px;
    }

    .concept__aside {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      padding-top: 16px;
      border-top: 1px solid var(--hairline-light);
    }

    .concept__contact {
      padding-top: 0;
      text-align: left;
    }
  }
</style>
