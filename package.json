{
  "name": "hertz-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HERTZ — премиальный лендинг студии звукозаписи. Astro + GSAP + Canvas.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "contrast": "node tools/contrast.mjs",
    "shot": "node tools/shot.mjs",
    "predeploy": "node tools/predeploy-check.mjs",
    "verify": "node tools/verify.mjs",
    "verify:fast": "node tools/verify.mjs --no-shots",
    "photos": "python tools/fetch_photos.py",
    "photos:check": "node tools/check-photos.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "astro": "7.4.7",
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3"
  }
}
